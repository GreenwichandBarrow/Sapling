# Codex scheduled-job environment.
# Authentication uses the saved Codex CLI ChatGPT/OAuth login for the ubuntu
# user. Do not set CODEX_API_KEY here; the scheduled runner explicitly unsets it
# before invoking `codex exec`.

# Optional single model for all scheduled jobs. Leave empty to use the
# scheduled-job router below.
export CODEX_MODEL=""

# Phase 2 cost routing. The runner uses the routine model for frequent,
# validator-backed jobs and the heavy model for judgment/research-heavy jobs.
export CODEX_ROUTINE_MODEL="gpt-5.4-mini"
export CODEX_HEAVY_MODEL="gpt-5.5"
