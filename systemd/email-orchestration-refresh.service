# Dashboard status refresh for email orchestration. Uses read-only sent-mail
# verification to clear completed follow-through rows; it cannot send email.

[Unit]
Description=G&B email-orchestration-refresh
After=email-intelligence.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/Sapling
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash -lc 'source %h/projects/Sapling/scripts/op-env.sh >/dev/null 2>&1; /usr/bin/python3 %h/projects/Sapling/scripts/refresh_email_orchestrator_status.py'

[Install]
WantedBy=default.target
